# Kopieren nach .env und ausfüllen. .env niemals committen (enthält Passwörter).

# Adresse der Verwaltungsseite, wie sie im Browser aufgerufen wird (mit https)
TALKIE_PUBLIC_URL=https://talkie.example.org
# E-Mail des ersten Admins (wird nur angelegt, solange es noch keinen Admin gibt)
TALKIE_ADMIN_EMAIL=du@example.org
# Steht in Einladungsmails
TALKIE_SERVER_ADDR=talkie.example.org:7777
TALKIE_DOWNLOAD_URL=https://github.com/ManuelW77/talkie/releases/latest

# Login per Mail (Port 587 = STARTTLS, 465 = TLS)
TALKIE_SMTP_HOST=smtp.example.org
TALKIE_SMTP_PORT=587
TALKIE_SMTP_USER=talkie@example.org
TALKIE_SMTP_PASS=geheim
TALKIE_SMTP_FROM=Talkie <talkie@example.org>

# Login per OIDC, z. B. Pocket ID (Callback-URL: TALKIE_PUBLIC_URL + /auth/oidc/callback)
TALKIE_OIDC_ISSUER=https://id.example.org
TALKIE_OIDC_CLIENT_ID=
TALKIE_OIDC_CLIENT_SECRET=
TALKIE_OIDC_NAME=Pocket ID

# Chatnachrichten nach so vielen Stunden löschen (0 = nie)
TALKIE_CHAT_HOURS=24

# Hinweis auf neue App-Versionen: Repo, das der Server täglich fragt (leer = aus) …
TALKIE_UPDATE_REPO=ManuelW77/talkie
# … oder Version fest vorgeben (dann ohne GitHub)
TALKIE_LATEST_VERSION=
